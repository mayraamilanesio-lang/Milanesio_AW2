# Copiar este archivo como .env y completar los valores
PORT=3000

# URI de conexion de MongoDB Atlas (o local: mongodb://127.0.0.1:27017/lumi_bakery)
MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/lumi_bakery

# Clave secreta para firmar los tokens JWT (cualquier texto largo y dificil de adivinar)
JWT_SECRET=cambiar_por_una_clave_secreta_larga
JWT_EXPIRES=2h
