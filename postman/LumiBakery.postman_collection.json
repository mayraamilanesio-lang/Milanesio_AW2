              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Colón 1450, Córdoba\",\n  \"productos\": [\n    {\n      \"id_producto\": \"{{productoId}}\",\n      \"cantidad\": 2\n    }\n  ]\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
