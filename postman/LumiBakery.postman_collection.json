{
  "info": {
    "name": "Lumi Bakery API - Entrega 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "1) Correr 'Login' (guarda el token solo). 2) Probar el resto. Las rutas POST/PUT/DELETE usan el token."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "ventaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lumi.com\",\n  \"contraseña\": \"1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login incorrecto (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lumi.com\",\n  \"contraseña\": \"mal\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear producto SIN token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"X\",\n  \"categoria\": \"Y\",\n  \"precio\": 1\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.length) pm.collectionVariables.set('productoId', d[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?categoria=Tortas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "Tortas"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Filtrar disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?disponible=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "disponible",
                  "value": "true"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Obtener producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{productoId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"BROWNIE\",\n  \"categoria\": \"Cookies\",\n  \"desc\": \"Brownie húmedo con nueces\",\n  \"precio\": 4000,\n  \"disponible\": true,\n  \"imagen\": \"\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set('productoId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{productoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 4500\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{productoId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
